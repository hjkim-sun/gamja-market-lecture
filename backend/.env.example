# Local database connection
# Copy this file to .env and replace the placeholder password locally.
DATABASE_URL=postgresql://postgres:your-local-password@localhost:5432/gamja_market

# Runtime-safe conventional logging
# Local development defaults to file; production defaults to stdout.
APP_ENV=development
APP_LOG_DESTINATION=auto
# Relative paths stay within backend/; an absolute writable volume path is also allowed.
APP_LOG_DIR=logs
APP_LOG_LEVEL=INFO
