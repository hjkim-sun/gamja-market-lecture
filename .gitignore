# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# JavaScript dependencies
node_modules/
.pnp
.pnp.*
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# testing
coverage/
.coverage
htmlcov/

# Next.js / production
.next/
out/
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (templates stay tracked)
.env*
!**/.env.example
# The backend runtime file can contain DATABASE_URL credentials.
/backend/.env

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Runtime JSONL logs (directory placeholders remain tracked)
backend/logs/*
!backend/logs/.gitkeep
frontend/logs/*
!frontend/logs/.gitkeep

# Local development service state and redirected console output
.runtime/
