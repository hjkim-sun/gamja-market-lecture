# Public Supabase project values. Use the publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Absolute public URL registered in Supabase Auth's Redirect URLs.
# Local development example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only FastAPI origin used by the /api/auth/signup rewrite.
# It defaults to http://localhost:8000 when unset.
BACKEND_API_URL=http://localhost:8000

# Server runtime logging. Local development defaults to a JSONL file in frontend/logs.
# Production defaults to stdout; set file only for a persistent self-hosted volume.
# Vercel always forces stdout and never creates a local log directory.
APP_LOG_DESTINATION=file
APP_LOG_DIR=logs
APP_ENV=development
